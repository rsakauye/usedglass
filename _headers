# Cloudflare Pages headers (ignored by GitHub Pages)
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Hashed build assets never change at the same URL: cache for a year.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=2592000

/retro-fonts.css
  Cache-Control: public, max-age=86400

# Daily data: an hour in the browser, a day stale-while-revalidate so a traffic spike never waits on origin.
/listings.json
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/kit-data.json
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/rss.xml
  Cache-Control: public, max-age=3600

/favicon.svg
  Cache-Control: public, max-age=604800

/favicon.ico
  Cache-Control: public, max-age=604800

/favicon-*
  Cache-Control: public, max-age=604800

/apple-touch-icon.png
  Cache-Control: public, max-age=604800

/og.png
  Cache-Control: public, max-age=604800

# Keep Cloudflare Pages preview hosts out of search (canonical is https://usedglass.ca)
https://:project.pages.dev/*
  X-Robots-Tag: noindex

https://:version.:project.pages.dev/*
  X-Robots-Tag: noindex
