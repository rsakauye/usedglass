---
import { kitAction } from '../lib/newsletter.js';
import { u } from '../lib/data.js';
// Footer: compact. /newsletter/: no props. Model page: modelKey + modelName (+ category), which turns the form
// into a "price-drop alert" card and records the model on the subscriber through Kit custom fields.
const { compact = false, modelKey = '', modelName = '', category = '' } = Astro.props;
const noun = category === 'lens' ? 'lens' : category === 'camera' ? 'camera' : 'model';
const hook = `Price-drop alert on this ${noun}`;
---
{modelKey ? (
  kitAction && (
    <section class="card nl-alert" style="max-width:720px;margin:.8rem 0 1rem">
      <h2 style="font-size:1.05rem;margin:0 0 .5rem">{hook}</h2>
      <form action={kitAction} method="post" class="nl-form" style="display:flex;gap:.5rem;flex-wrap:wrap;align-items:center">
        <label for="nl-email-model" class="sr-only" style="position:absolute;left:-9999px">Email address</label>
        <input id="nl-email-model" type="email" name="email_address" required placeholder="you@example.com" autocomplete="email" style="flex:1;min-width:200px" />
        <input type="hidden" name="fields[model_key]" value={modelKey} />
        <input type="hidden" name="fields[model_name]" value={modelName} />
        <button type="submit">{hook}</button>
        <p class="muted" style="flex-basis:100%;margin:.25rem 0 0">Free. We'll email you if this {noun} drops in price, plus the weekly deals. Unsubscribe anytime. <a href={u('privacy/#newsletter')}>Privacy</a></p>
      </form>
    </section>
  )
) : kitAction ? (
  <form action={kitAction} method="post" class="nl-form" style="display:flex;gap:.5rem;flex-wrap:wrap;align-items:center">
    <label for={compact ? 'nl-email-footer' : 'nl-email'} class="sr-only" style="position:absolute;left:-9999px">Email address</label>
    <input id={compact ? 'nl-email-footer' : 'nl-email'} type="email" name="email_address" required placeholder="you@example.com" autocomplete="email" style="flex:1;min-width:200px" />
    <button type="submit">{compact ? 'Subscribe' : 'Get the weekly deals'}</button>
    {!compact && <p class="muted" style="flex-basis:100%;margin:.25rem 0 0">Free. One email a week. Unsubscribe anytime.</p>}
  </form>
) : (
  compact
    ? <span class="muted">Newsletter launching soon. <a href={u('newsletter/')}>Details</a></span>
    : <div><p><b>Sign-up is coming soon.</b></p><p class="muted">Until then, follow the <a href={u('rss.xml')}>deals RSS feed</a>.</p></div>
)}
