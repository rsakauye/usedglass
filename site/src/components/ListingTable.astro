---
// Shared listing table. Desktop: a normal table. Below 640px each row becomes a stacked card (CSS in Base.astro):
// title, then dealer · condition · score with the price on the right, then tags and a relative "as of" time.
import { money, asOf, modelUrl, shortDate } from '../lib/data.js';
import ScoreBadge from './ScoreBadge.astro';
import SaveButton from './SaveButton.astro';
const { rows = [], showModel = true, showScoreWhy = false, hideAfter = 0 } = Astro.props;
---
<table class="ltable">
  <thead><tr><th>Item</th><th>Dealer</th><th>Condition</th><th class="price">Price (CAD)</th><th>As of</th></tr></thead>
  <tbody>
    {rows.map((l, i) => (
      <tr data-s={l.deal_score ?? -1} data-p={l.price_cad} class={hideAfter && i >= hideAfter ? 'v-hide' : undefined}>
        <td class="c-item">
          <a class="l-title" href={l.url} rel="nofollow noopener" target="_blank">{l.title}</a>
          <div class="m-only l-mid">
            <span class="l-meta">{l.dealer}{l.location && ` (${l.location})`} · {l.condition ?? 'Not graded'}{l.deal_score != null && <> <ScoreBadge score={l.deal_score} why={l.score_why} compact={true} /></>}</span>
            <span class="l-price">{money(l.price_cad)}{l.prev_price && l.prev_price > l.price_cad && <s class="muted">{money(l.prev_price)}</s>}</span>
          </div>
          <div class="l-tags">
            {l.model_key && <SaveButton k={l.model_key} n={l.model_name || l.title} m={l.mount} cat={l.category} />}
            {l.mount && <span class="pill">{l.mount}</span>}
            {showModel && l.model_key && <a class="pill" href={modelUrl(l.model_key)}>Compare prices</a>}
            {l._badge && <span class="pill good">{l._badge}</span>}
            {l.deal_score != null && <span class="d-only"><ScoreBadge score={l.deal_score} why={l.score_why} compact={!showScoreWhy} /></span>}
            {l.stale && <span class="pill warn m-only">older data</span>}
            <time class="m-only l-time" datetime={l.fetched_at} title={asOf(l.fetched_at)} data-rel>{shortDate(l.fetched_at)}</time>
          </div>
          {showScoreWhy && l.score_why && <div class="m-only muted l-why">{l.score_why.join('; ')}.</div>}
        </td>
        <td class="d-cell">{l.dealer}{l.location && <div class="muted">{l.location}</div>}</td>
        <td class="d-cell">{l.condition ?? <span class="muted">Not graded</span>}</td>
        <td class="d-cell price">{money(l.price_cad)}{l.prev_price && l.prev_price > l.price_cad && <div class="muted"><s>{money(l.prev_price)}</s></div>}</td>
        <td class="d-cell muted">{asOf(l.fetched_at)}{l.stale && <div class="pill warn">dealer fetch failed, older data</div>}</td>
      </tr>
    ))}
  </tbody>
</table>
