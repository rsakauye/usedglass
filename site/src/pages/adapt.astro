---
import Base from '../layouts/Base.astro';
import fs from 'node:fs';
import path from 'node:path';
import { listings, models, u } from '../lib/data.js';
import { classifyAdapter, brandOf, conditionOf } from '../lib/adapt.js';
import { AMAZON_TAG, SPONSORED_REL } from '../lib/affiliate.js';

const DATA_DIR = process.env.DATA_DIR || path.resolve(process.cwd(), '..', 'data');
const mdata = JSON.parse(fs.readFileSync(path.join(DATA_DIR, 'mounts.json'), 'utf8'));
const mounts = mdata.mounts;
const names = Object.keys(mounts).sort((a, b) => a.localeCompare(b));
// Our in-stock adapter listings, classified into lens>body pairs at build time.
const adapters = listings.filter((l) => l.in_stock !== false && l.price_cad != null).map((l) => {
  const c = classifyAdapter(l.title);
  return c && mounts[c.from] && mounts[c.to] ? { from: c.from, to: c.to, b: brandOf(l.title), c: conditionOf(l), p: l.price_cad, d: l.dealer, url: l.url, t: l.title } : null;
}).filter(Boolean).sort((a, b) => a.p - b.p);
// Mount of each tracked model, for the "pick your gear" shortcut.
const gear = Object.values(models).filter((m) => m.mount && (m.category === 'camera' || m.category === 'lens'))
  .map((m) => [m.name, m.category === 'camera' ? 'c' : 'l', m.mount]).sort((a, b) => a[0].localeCompare(b[0]));
---
<Base title="Can I make this work with my camera? Lens mount adapter checker" description="Pick your camera and a lens to see if they fit natively, with an adapter, with catches, or not at all. Shows new and used mount adapters in stock at Canadian dealers.">
  <style is:global>
    .ad-pick { display:grid; grid-template-columns:1fr auto 1fr; gap:.6rem; align-items:end; }
    .ad-pick label { display:flex; flex-direction:column; gap:.25rem; font-weight:600; }
    .ad-pick select, .ad-pick input { width:100%; padding:.45rem; font-size:1rem; }
    .ad-swap { padding:.45rem .7rem; }
    .ad-v { margin:1rem 0; border-left:6px solid var(--line); }
    .ad-v h2 { margin:.1rem 0 .4rem; font-size:1.25rem; }
    .ad-v.native { border-left-color:var(--good); } .ad-v.adapter { border-left-color:var(--accent); }
    .ad-v.limits { border-left-color:var(--warn); } .ad-v.impossible { border-left-color:#b42318; }
    .ad-v ul { margin:.3rem 0 0 1.1rem; padding:0; } .ad-v li { margin:.2rem 0; }
    .ad-nums { font-variant-numeric:tabular-nums; }
    .ad-list { list-style:none; padding:0; margin:0; } .ad-list li { padding:.5rem 0; border-bottom:1px solid var(--line); }
    @media (max-width: 640px) { .ad-pick { grid-template-columns:1fr; } .ad-swap { justify-self:start; } }
  </style>
  <h1>Can I make this work with my camera?</h1>
  <p class="muted">Pick the lens mount and the camera mount. We'll tell you whether they fit natively, with an adapter, with catches, or not at all, and show adapters for sale at Canadian dealers.</p>
  <div class="card">
    <label style="display:block;margin-bottom:.6rem">Shortcut: type a camera or lens we track
      <input id="ad-q" list="ad-gear" placeholder="e.g. Sony A7 III or Canon EF 50mm" autocomplete="off" style="width:100%;padding:.45rem" />
      <datalist id="ad-gear">{gear.map((g) => <option value={g[0]} />)}</datalist>
    </label>
    <div class="ad-pick">
      <label>Lens mount<select id="ad-lens"><option value="">Choose…</option>{names.map((n) => <option>{n}</option>)}<option>Fixed Lens</option></select></label>
      <button type="button" class="ad-swap secondary" id="ad-swap" aria-label="Swap lens and camera mounts">⇄</button>
      <label>Camera mount<select id="ad-body"><option value="">Choose…</option>{names.map((n) => <option>{n}</option>)}<option>Fixed Lens</option></select></label>
    </div>
  </div>
  <div id="ad-out" aria-live="polite"></div>
  <h2>How this works</h2>
  <p>Every mount puts the lens a set distance from the film or sensor (the flange distance). An adapter is a spacer that makes up the difference, so it only works when the lens mount's distance is longer than the camera's. That's why most older SLR lenses adapt to mirrorless cameras, but mirrorless lenses can't go on SLRs. Autofocus and electronic aperture control need an adapter with electronics.</p>
  <details><summary>Mount numbers we use ({names.length} mounts)</summary>
    <table class="ad-nums"><thead><tr><th>Mount</th><th>Flange</th><th>Throat</th><th>Type</th></tr></thead>
      <tbody>{names.map((n) => <tr><td>{n}</td><td>{mounts[n].flange_mm} mm</td><td>{mounts[n].throat_mm ? `${mounts[n].throat_mm} mm` : '—'}</td><td>{mounts[n].type}</td></tr>)}</tbody></table>
    <p class="muted">Sources: <a href="https://en.wikipedia.org/wiki/Flange_focal_distance" rel="nofollow noopener" target="_blank">flange focal distance table</a> and each mount's own article for throat diameter. Checked {mdata.checked}.</p>
  </details>
  <p class="muted">Simplified rules: they can't know every lens, firmware or adapter quirk. Always check the adapter maker's compatibility list before you buy. Amazon links are affiliate links.</p>

  <script define:vars={{ mounts, adapters, gear, tag: AMAZON_TAG, rel: SPONSORED_REL, myUrl: u('my/') }}>
    window.__ad = { mounts, adapters, gear, tag, rel, myUrl };
  </script>
  <script>
    import { verdict } from '../lib/adapt.js';
    const { mounts, adapters, gear, tag, rel } = (window as any).__ad;
    const $ = (id: string) => document.getElementById(id) as any;
    const esc = (s: any) => String(s).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' } as any)[c]);
    const money = (v: number) => '$' + v.toLocaleString('en-CA', { minimumFractionDigits: v % 1 ? 2 : 0, maximumFractionDigits: 2 });
    const amazon = (q: string) => `https://www.amazon.ca/s?k=${encodeURIComponent(q)}&tag=${encodeURIComponent(tag)}`;
    function render() {
      const L = $('ad-lens').value, B = $('ad-body').value, out = $('ad-out');
      const qs = new URLSearchParams(); if (L) qs.set('lens', L); if (B) qs.set('body', B);
      history.replaceState(null, '', qs.toString() ? '?' + qs : location.pathname);
      if (!L || !B) { out.innerHTML = ''; return; }
      const v = verdict(L, B, mounts);
      let h = `<section class="card ad-v ${v.verdict}"><p class="muted" style="margin:0">${esc(L)} lens on a ${esc(B)} camera</p><h2>${esc(v.title)}</h2>`;
      if (mounts[L] && mounts[B] && L !== B) h += `<p class="ad-nums muted" style="margin:.2rem 0">Flange distance: lens ${mounts[L].flange_mm} mm, camera ${mounts[B].flange_mm} mm (${v.gap >= 0 ? `${v.gap} mm of room for an adapter` : `${Math.abs(v.gap)} mm short`}).</p>`;
      if (v.notes.length) h += `<ul>${v.notes.map((n: string) => `<li>${esc(n)}</li>`).join('')}</ul>`;
      h += '</section>';
      if (v.verdict === 'adapter' || v.verdict === 'limits') {
        const rows = adapters.filter((a: any) => a.from === L && a.to === B);
        const q = `${L} to ${B} lens mount adapter`;
        h += `<h2>Adapters for sale (${rows.length} in stock at our dealers)</h2>`;
        if (rows.length) h += `<ul class="ad-list">${rows.map((a: any) => `<li><a href="${esc(a.url)}" rel="nofollow noopener" target="_blank">${esc(a.t)}</a><br><b>${money(a.p)}</b> · ${esc(a.c)} · ${esc(a.d)}${a.b ? ` · ${esc(a.b)}` : ''}</li>`).join('')}</ul>`;
        else h += `<p>None of our Canadian dealers has a ${esc(L)} to ${esc(B)} adapter in stock today.</p>`;
        h += `<p class="amazon-cta"><a href="${amazon(q)}" rel="${rel}" target="_blank">${rows.length ? 'Compare new adapters' : 'Search new adapters'} on Amazon.ca</a> <span class="muted">(affiliate link)</span></p>`;
      }
      out.innerHTML = h;
    }
    const p = new URLSearchParams(location.search);
    if (p.get('lens')) $('ad-lens').value = p.get('lens');
    if (p.get('body')) $('ad-body').value = p.get('body');
    $('ad-lens').addEventListener('change', render); $('ad-body').addEventListener('change', render);
    $('ad-swap').addEventListener('click', () => { const t = $('ad-lens').value; $('ad-lens').value = $('ad-body').value; $('ad-body').value = t; render(); });
    $('ad-q').addEventListener('change', () => {
      const g = gear.find((x: any) => x[0] === $('ad-q').value); if (!g) return;
      $(g[1] === 'c' ? 'ad-body' : 'ad-lens').value = g[2]; $('ad-q').value = ''; render();
      $(g[1] === 'c' ? 'ad-lens' : 'ad-body').focus();
    });
    render();
  </script>
</Base>
