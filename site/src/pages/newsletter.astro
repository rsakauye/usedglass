---
import Base from '../layouts/Base.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
import { u } from '../lib/data.js';
---
<Base title="Weekly used-gear deals newsletter">
  <h1>The UsedGlass weekly</h1>
  <p>Every Friday: the best used camera and lens deals in Canada, new manufacturer rebates, and the biggest price drops of the week. Free.</p>
  <div class="card" style="max-width:520px">
    <NewsletterForm />
  </div>
  <p class="muted">Also available: the <a href={u('rss.xml')}>deals RSS feed</a>.</p>
</Base>
