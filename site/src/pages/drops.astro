---
import Base from '../layouts/Base.astro';
import ListingTable from '../components/ListingTable.astro';
import { changes, byId, money, u } from '../lib/data.js';
const drops = (changes.price_dropped || []).filter((d) => byId[d.id]).sort((a, b) => b.pct - a.pct);
const rows = drops.map((d) => ({ ...byId[d.id], prev_price: d.old, _badge: `-${Math.round(d.pct * 100)}%` }));
---
<Base title="Used camera gear price drops" description="Used cameras and lenses whose prices just dropped at Canadian dealers, with the old and new price side by side. Updated daily.">
  <h1>Price drops</h1>
  <p class="muted">Listings whose price went down since the previous daily check ({changes.date}).</p>
  <p class="muted">Biggest drops of the last seven days, as a feed: <a href={u('feeds/biggest-drops.json')}>JSON</a> or <a href={u('feeds/biggest-drops.xml')}>RSS</a>.</p>
  {rows.length ? <ListingTable rows={rows} /> : <p class="card">No price drops yet. Drops show up after at least two daily checks.</p>}
</Base>
