---
import NewsletterForm from '../components/NewsletterForm.astro';
import { u, meta, asOf } from '../lib/data.js';
import { AMAZON_DISCLOSURE } from '../lib/affiliate.js';
const { title = 'UsedGlass.ca', description = 'Used camera and lens prices from Canadian dealers, updated daily.' } = Astro.props;
const fullTitle = title === 'UsedGlass.ca' ? 'UsedGlass.ca: used camera & lens prices in Canada' : `${title} · UsedGlass.ca`;
---
<!doctype html>
<html lang="en-CA">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <meta name="fo-verify" content="80e91ecb-ef5e-4e35-9def-f6aecc44206b" />
  <link rel="alternate" type="application/rss+xml" title="UsedGlass.ca deals" href={u('rss.xml')} />
  <link rel="icon" href={u('favicon.svg')} type="image/svg+xml" />
  <script is:inline>
    // "2h ago" for <time data-rel datetime=...>; the full timestamp stays in the title attribute.
    window.ugRel = function (root) {
      (root || document).querySelectorAll('time[data-rel]').forEach(function (t) {
        var s = (Date.now() - Date.parse(t.getAttribute('datetime'))) / 1000;
        if (!isFinite(s) || s < 0) return;
        t.textContent = s < 3600 ? Math.max(1, Math.round(s / 60)) + 'm ago' : s < 86400 ? Math.round(s / 3600) + 'h ago' : Math.round(s / 86400) + 'd ago';
      });
    };
    document.addEventListener('DOMContentLoaded', function () { window.ugRel(document); });
  </script>
  <style is:global>
    :root { --fg:#16181d; --muted:#5b6170; --bg:#fafafa; --card:#fff; --line:#e4e6eb; --accent:#0f6fde; --good:#0a7d38; --warn:#b54708; }
    * { box-sizing: border-box; }
    body { margin:0; font: 16px/1.5 system-ui, -apple-system, Segoe UI, Roboto, sans-serif; color:var(--fg); background:var(--bg); }
    a { color: var(--accent); }
    header.site { background:#111; color:#fff; }
    header.site .wrap { display:flex; flex-wrap:wrap; gap:1rem; align-items:center; justify-content:space-between; }
    header.site a { color:#fff; text-decoration:none; }
    header.site nav a { margin-right:1rem; opacity:.85; font-size:.95rem; }
    header.site nav a:hover { opacity:1; }
    .logo { font-weight:800; font-size:1.25rem; letter-spacing:-.02em; }
    .logo span { color:#7cc4ff; }
    .wrap { max-width:1150px; margin:0 auto; padding:.8rem 1rem; }
    main.wrap { padding-top:1.2rem; padding-bottom:3rem; }
    .card { background:var(--card); border:1px solid var(--line); border-radius:10px; padding:1rem; }
    .muted { color:var(--muted); font-size:.9rem; }
    table { border-collapse: collapse; width:100%; background:var(--card); }
    th, td { text-align:left; padding:.45rem .55rem; border-bottom:1px solid var(--line); vertical-align:top; font-size:.93rem; }
    th { background:#f2f3f5; font-weight:600; }
    td.price, th.price { text-align:right; white-space:nowrap; font-variant-numeric: tabular-nums; }
    .pill { display:inline-block; font-size:.75rem; padding:.05rem .45rem; border-radius:99px; background:#eef1f6; color:#334; margin-right:.25rem; white-space:nowrap; }
    .pill.good { background:#e3f6ea; color:var(--good); }
    .pill.warn { background:#fff1e6; color:var(--warn); }
    .grid { display:grid; gap:1rem; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); }
    .deal { border-left:4px solid var(--good); }
    .big { font-size:1.6rem; font-weight:700; }
    footer.site { border-top:1px solid var(--line); background:#fff; }
    footer.site .wrap { display:flex; flex-wrap:wrap; gap:1.5rem; justify-content:space-between; font-size:.9rem; }
    input, select, button { font:inherit; padding:.4rem .5rem; border:1px solid #c9ccd3; border-radius:6px; background:#fff; }
    button { cursor:pointer; background:var(--accent); color:#fff; border-color:var(--accent); }
    h1 { line-height:1.2; margin:.2rem 0 .6rem; }
    .stats { display:flex; flex-wrap:wrap; gap:1.5rem; margin:.6rem 0 1rem; }
    .stats div b { display:block; font-size:1.3rem; }
    .pill.score { text-decoration:none; font-weight:600; }
    .score-why { display:block; font-size:.82rem; margin-top:.15rem; }
    .m-only { display:none; }
    .l-title { overflow-wrap:anywhere; }
    img, svg, video { max-width:100%; }
    @media (max-width: 640px) {
      .wrap { padding-left:.75rem; padding-right:.75rem; }
      h1 { font-size:1.6rem; }
      td, th { overflow-wrap:anywhere; }
      /* other tables scroll inside themselves instead of widening the page */
      table:not(.ltable) { display:block; overflow-x:auto; max-width:100%; }
      /* listing tables become stacked cards */
      .ltable, .ltable tbody { display:block; background:none; }
      .ltable thead, .ltable .d-cell, .ltable .d-only { display:none; }
      .ltable tr { display:block; background:var(--card); border:1px solid var(--line); border-radius:10px; padding:.65rem .75rem; margin-bottom:.6rem; }
      .ltable td.c-item { display:block; border:0; padding:0; }
      .ltable .l-title { display:block; font-weight:600; line-height:1.3; }
      .ltable .m-only { display:inline; }
      .ltable .l-mid { display:flex; justify-content:space-between; align-items:baseline; gap:.6rem; margin:.3rem 0 .25rem; }
      .ltable .l-meta { font-size:.88rem; color:var(--muted); min-width:0; }
      .ltable .l-price { font-size:1.25rem; font-weight:700; white-space:nowrap; font-variant-numeric:tabular-nums; text-align:right; }
      .ltable .l-price s { display:block; font-size:.8rem; font-weight:400; }
      .ltable .l-tags { display:flex; flex-wrap:wrap; gap:.25rem; align-items:center; }
      .ltable .l-time { margin-left:auto; font-size:.8rem; color:var(--muted); white-space:nowrap; }
      .ltable .l-why { display:block; font-size:.8rem; margin-top:.3rem; }
      form.card label { flex:1 1 45%; }
      form.card input, form.card select { width:100%; }
    }
  </style>
</head>
<body>
  <header class="site">
    <div class="wrap">
      <a class="logo" href={u('')}>Used<span>Glass</span>.ca</a>
      <nav>
        <a href={u('')}>Search</a>
        <a href={u('deals/')}>Deals</a>
        <a href={u('new/')}>New today</a>
        <a href={u('drops/')}>Price drops</a>
        <a href={u('rebates/')}>Rebates</a>
        <a href={u('currency/')}>Currency</a>
        <a href={u('dealers/')}>Dealers</a>
        <a href={u('about/')}>About</a>
      </nav>
    </div>
  </header>
  <main class="wrap"><slot /></main>
  <footer class="site">
    <div class="wrap">
      <div>
        <b>Get the weekly used-gear deals email</b><br />
        <NewsletterForm compact={true} />
      </div>
      <div class="muted">
        Data refreshed daily from dealer websites. Last update: {asOf(meta.run_at)}.<br />
        Prices and availability change; always confirm on the dealer's site. <a href={u('about/')}>Disclaimer &amp; dealer opt-out</a> · <a href={u('rss.xml')}>RSS</a> · <a href={u('privacy/')}>Privacy</a> · <a href={u('terms/')}>Terms</a><br />
        <span class="affiliate-disclosure">Some links are affiliate links, so we may earn a commission at no extra cost to you. {AMAZON_DISCLOSURE} <a href={u('about/#affiliates')}>Learn more</a></span>
      </div>
    </div>
  </footer>
</body>
</html>
